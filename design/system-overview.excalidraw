      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional requirements:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EhbQ2jus6vYmfNmsss9d-",
      "type": "text",
      "x": 2603.687399078217,
      "y": -2912.5520060354593,
      "width": 679.2796020507812,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 1645781776,
      "version": 209,
      "versionNonce": 1593347856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785764855337,
      "link": null,
      "locked": false,
      "text": "1. the system should prioritize availability over consistency\n2. the system should provide feature flags with low latency (<100ms)\n3. the system should be a self-hosted ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. the system should prioritize availability over consistency\n2. the system should provide feature flags with low latency (<100ms)\n3. the system should be a self-hosted ",
      "autoResize": true,
      "lineHeight": 1.25
    },
